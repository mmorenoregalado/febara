{
	"name": "pokedex-manager",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"build": "dotenv -c -- turbo build",
		"dev": "dotenv -c -- turbo dev --concurrency 15",
		"start": "pnpm run dev",
		"lint": "pnpm --filter @repo/database run generate && oxlint",
		"lint:fix": "oxlint --fix",
		"clean": "turbo clean",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"type-check": "dotenv -c -- turbo type-check",
		"test": "dotenv -c -- turbo test"
	},
	"devDependencies": {
		"@repo/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"dotenv-cli": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "^7.0.2001",
		"turbo": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.3.0"
}
