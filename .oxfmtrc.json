{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"arrowParens": "always",
	"printWidth": 100,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"semi": true,
	"trailingComma": "all",
	"vueIndentScriptAndStyle": true,
	"sortImports": {
		"groups": [
			"builtin",
			"external",
			["internal", "subpath"],
			["parent", "sibling", "index"],
			"style",
			"unknown"
		]
	},
	"sortTailwindcss": {
		"attributes": ["class", "className", ":class", "ui", ":ui"],
		"functions": ["cn"],
		"stylesheet": "./tooling/tailwind/theme.css"
	},
	"sortPackageJson": true,
	"ignorePatterns": ["packages/database/prisma/zod/**.ts", "packages/mail/emails/**/*.html"]
}
