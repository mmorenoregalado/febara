{
	"extends": "@repo/tsconfig/base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "preserve"
	},
	"include": [".vitepress/**/*.ts", ".vitepress/**/*.vue"],
	"exclude": ["node_modules", "dist"]
}
