# Database
DATABASE_URL="YOUR_DATABASE_CONNECTION_STRING"
# ... if you use Supabase
# DIRECT_URL=""

# App URLs (local dev: saas 3000, marketing 3001, docs 3002)
# NUXT_PUBLIC_SAAS_URL is the canonical base URL for auth, API, and the SaaS app; use the same
# value as NUXT_PUBLIC_SITE_URL in dev unless you split apps across hosts.
NUXT_PUBLIC_SAAS_URL="http://localhost:3000"
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
NUXT_PUBLIC_MARKETING_URL="http://localhost:3001"
NUXT_PUBLIC_DOCS_URL="http://localhost:3002"

# Mail (from address is required for most providers; use a verified domain/sender in production)
MAIL_FROM="PokeDex Manager <onboarding@example.com>"

# Mails
# ... with nodemailer
MAIL_HOST=""
MAIL_PORT=""
MAIL_USER=""
MAIL_PASS=""
# ... with Resend
RESEND_API_KEY=""

# Authentication
# ... for Google
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Storage
# ... with S3
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION=""
NUXT_PUBLIC_AVATARS_BUCKET_NAME="avatars"

# AI
# ... with OpenAI
OPENAI_API_KEY=""
